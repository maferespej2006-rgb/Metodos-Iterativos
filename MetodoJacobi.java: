package Ecuaciones_lineales.JACOBI;

public class MetodoJacobi {

    // Método para calcular el error entre dos vectores
    public static double calcularError(double[] xAnterior, double[] xNuevo) {
        double error = 0.0;
        for (int i = 0; i < xAnterior.length; i++) {
            error = Math.max(error, Math.abs(xNuevo[i] - xAnterior[i]));
        }
        return error;
    }

    // Implementación completa del Método de Jacobi
    public static double[] jacobi(double[][] A, double[] b,
                                   double[] xInicial, double tol, int maxIter) {
        int n = xInicial.length;
        double[] x = xInicial.clone();
        double[] xNuevo = new double[n];

        System.out.println("\n=== MÉTODO DE JACOBI ===");
        System.out.printf("%-5s %-12s %-12s %-12s %-12s%n", 
                          "Iter", "x1", "x2", "x3", "Error");
        System.out.println("-------------------------------------------------------");

        for (int iter = 0; iter < maxIter; iter++) {
            for (int i = 0; i < n; i++) {
                double suma = b[i];
                for (int j = 0; j < n; j++) {
                    if (j != i) {
                        suma -= A[i][j] * x[j];
                    }
                }
                xNuevo[i] = suma / A[i][i];
            }

            double error = calcularError(x, xNuevo);
            System.out.printf("%-5d %-12.6f %-12.6f %-12.6f %-12.6f%n",
                             iter + 1, xNuevo[0], xNuevo[1], xNuevo[2], error);

            // Copiamos los nuevos valores
            System.arraycopy(xNuevo, 0, x, 0, n);

            if (error < tol) {
                System.out.println("-------------------------------------------------------");
                System.out.println("✅ Convergencia alcanzada en " + (iter + 1) + " iteraciones\n");
                return x;
            }
        }

        System.out.println("⚠️ Se alcanzó el máximo de iteraciones sin convergencia\n");
        return x;
    }
}
